# ── PostgreSQL (existing server) ──────────────────────────────────────────────
PG_HOST=your-pg-host.postgres.database.azure.com
PG_PORT=5432
PG_DB=terminplanung
PG_USER=terminplanung
PG_PASSWORD=change-me

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://terminplanung:change-me@your-pg-host.postgres.database.azure.com:5432/terminplanung
# For local SQLite dev: DATABASE_URL=sqlite:////data/terminplanung.db
ALLOWED_ORIGINS=["https://terminplanung.example.com"]
SECRET_KEY=change-me-in-production-use-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...

# ── Azure Deployment ──────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=terminplanung-rg
AZURE_LOCATION=germanywestcentral
ACI_GROUP_NAME=terminplanung-group
ACI_DNS_LABEL=terminplanung
STORAGE_ACCOUNT_NAME=

# ── Domain & TLS ──────────────────────────────────────────────────────────────
APP_DOMAIN=terminplanung.example.com
LETSENCRYPT_EMAIL=admin@example.com
